# ProcurePilot Frontend Environment Configuration
# Copy this file to .env.local and update the values

# API Configuration
# The backend API base URL for development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend Swagger docs URL (used by the Docs button)
NEXT_PUBLIC_API_DOCS_URL=http://localhost:8000/docs

# Optional: Analytics or other public configuration
# NEXT_PUBLIC_ANALYTICS_ID=
